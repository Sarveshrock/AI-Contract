# ContractLens Enterprise — configuration. Copy to `.env` (never commit `.env`).
# Leave Supabase blank to run in local DEMO mode (SQLite + local files, single demo user).

# --- Runtime -----------------------------------------------------------------------------
CONTRACTLENS_MODE=auto            # auto | supabase | local
LOG_LEVEL=INFO
# DATA_DIR=./data
# REDUCED_MOTION=false

# --- Supabase (desktop client uses the ANON / publishable key only) -----------------------
# NEVER put a service-role key here: the app refuses to start if it detects one.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=contracts

# --- OpenAI --------------------------------------------------------------------------------
# Option A (development / single user): direct key on this machine.
OPENAI_API_KEY=
# Option B (recommended for teams): leave OPENAI_API_KEY empty and point at the Edge Function
# supabase/functions/openai-proxy. Requests then authenticate with the user's Supabase session and the
# OpenAI key lives only in server-side secrets.
# OPENAI_BASE_URL=https://<project-ref>.supabase.co/functions/v1/openai-proxy
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_S=90
EMBEDDING_PROVIDER=auto           # auto | openai | hashing (offline, lexical quality only)

# --- ChromaDB ------------------------------------------------------------------------------
# persistent: embedded, per machine (guarded by a start-up self-test; falls back to a local SQLite index if it fails)
# http:       shared Chroma server behind TLS + token auth (recommended for teams)
# memory:     volatile, testing only
CHROMA_MODE=persistent
# CHROMA_PATH=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_TOKEN=

# --- Documents / OCR -----------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PAGES=600
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=eng
OCR_DPI=200

# --- Quality -------------------------------------------------------------------------------
QUALITY_THRESHOLD=0.75            # analysis runs scoring below this are routed to human review
AGENT_MAX_ATTEMPTS=3

